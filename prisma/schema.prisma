generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Niveau {
  NIVEAU_1
  NIVEAU_2
}

enum ClientType {
  PARTICULIER
  ENTREPRISE
}

enum Categorie {
  ELEVEUR
  DISTRIBUTEUR
}

enum CategorieTaille {
  TRES_GROS
  GROS
  MOYEN
  PETIT
  TRES_PETIT
}

enum ModePaiement {
  ESPECE
  VERSEMENT
  VIREMENT
  CHEQUE
  MOBILE_MONEY_GMA
}

enum StatutCommande {
  EN_ATTENTE_VALIDATION
  VALIDEE_ATTENTE_LIVRAISON
  LIVREE
  FACTUREE
  ANNULEE
}

model Compte {
  id        Int      @id @default(autoincrement())
  identifiant String @unique
  codeHash  String
  niveau    Niveau
  actif     Boolean  @default(true)
  createdAt DateTime @default(now())

  commandesCreees   Commande[] @relation("CreePar")
  commandesValidees Commande[] @relation("ValidePar")
  commandesLivrees  Commande[] @relation("LivreConfirmePar")
}

model Client {
  id                          Int       @id @default(autoincrement())
  type                        ClientType
  nomRaisonSociale            String
  categorie                   Categorie
  categorieTaille             CategorieTaille?
  dfe                         String?
  rccm                        String?
  localisation                String?
  telephone                   String?
  email                       String?
  adresse                     String?
  produitPredilectionId       Int?
  produitPredilection         Produit?  @relation(fields: [produitPredilectionId], references: [id])
  potentielMensuelTonnes      Float?
  frequenceAchatEstimeeJours  Int?
  frequenceAchatReelleJours   Int?
  modePaiementDefaut          ModePaiement?
  dateDernierAchat            DateTime?
  dateAchatTheoriqueSuivant   DateTime?
  createdAt                   DateTime  @default(now())

  commandes Commande[]
}

model Produit {
  id            Int      @id @default(autoincrement())
  nom           String
  prixUnitaire  Float
  unite         String
  tauxTva       Float    @default(9)
  actif         Boolean  @default(true)

  clients Client[]
  lignes  CommandeLigne[]
}

model Commande {
  id                     Int             @id @default(autoincrement())
  clientId               Int
  client                 Client          @relation(fields: [clientId], references: [id])
  creeParId              Int?
  creePar                Compte?         @relation("CreePar", fields: [creeParId], references: [id])
  valideParId            Int?
  validePar              Compte?         @relation("ValidePar", fields: [valideParId], references: [id])
  livreConfirmeParId     Int?
  livreConfirmePar       Compte?         @relation("LivreConfirmePar", fields: [livreConfirmeParId], references: [id])
  statut                 StatutCommande  @default(EN_ATTENTE_VALIDATION)
  dateCreation            DateTime       @default(now())
  dateLivraisonPlanifiee  DateTime?
  dateLivraisonConfirmee  DateTime?
  modePaiement            ModePaiement
  credit                  Float?
  delaiPaiementJours      Int?
  montantTotalHt          Float
  montantTva              Float
  montantTotalTtc         Float

  lignes  CommandeLigne[]
  preuves PreuvePaiement[]
}

model CommandeLigne {
  id                    Int      @id @default(autoincrement())
  commandeId            Int
  commande              Commande @relation(fields: [commandeId], references: [id])
  produitId             Int
  produit               Produit  @relation(fields: [produitId], references: [id])
  quantite              Float
  prixUnitaireApplique  Float
  sousTotal             Float
}

model PreuvePaiement {
  id          Int      @id @default(autoincrement())
  commandeId  Int
  commande    Commande @relation(fields: [commandeId], references: [id])
  fichierUrl  String
  uploadedAt  DateTime @default(now())
}
