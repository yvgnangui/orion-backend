# Base de données PostgreSQL (fournie automatiquement par Railway/Hetzner selon l'hébergeur)
DATABASE_URL="postgresql://user:password@host:5432/orion"

# Clé secrète pour signer les tokens JWT — générez une chaîne longue et aléatoire, jamais devinable
JWT_SECRET="changez-moi-en-production-avec-une-longue-chaine-aleatoire"

# URL du frontend autorisée à appeler cette API (CORS)
FRONTEND_URL="https://app.orion-international.ci"

PORT=3000
